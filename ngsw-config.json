{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.js",
          "/*.css",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/icons/app-*.png"
        ]
      }
    },
    {
      "name": "icons",
      "installMode": "lazy",
      "resources": {
        "files": [
          "/assets/**/*.svg"
        ]
      }
    }
  ]
}
